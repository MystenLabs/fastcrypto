      core.fmt.Arguments.new
        (Array.make 29#usize [
          26#u8, 76#u8, 101#u8, 97#u8, 102#u8, 32#u8, 105#u8, 110#u8, 100#u8,
          101#u8, 120#u8, 32#u8, 111#u8, 117#u8, 116#u8, 32#u8, 111#u8, 102#u8,
          32#u8, 98#u8, 111#u8, 117#u8, 110#u8, 100#u8, 115#u8, 58#u8, 32#u8,
          192#u8, 0#u8
          ]) (Array.make 1#usize [ a ])
    let s ← alloc.fmt.format a1
    let s1 ← core.hint.must_use s
    ok (core.result.Result.Err (error.FastCryptoError.GeneralError s1))
  else
    let path ←
      merkle.MerkleTree.get_proof_loop self.nodes (alloc.vec.Vec.new
        merkle.Node) leaf_index self.n_leaves 0#usize
    ok (core.result.Result.Ok { _hash_type := (), path })

end fastcrypto
