import Lake
open Lake DSL

-- The Aeneas Lean library, at the commit of the nightly release whose Charon and Aeneas
-- generated `Avss` (see `extract.sh`).
require aeneas from git "https://github.com/AeneasVerif/aeneas" @
  "1dc8ad31b1b062a77c50e29144a6c7bba955fa09" / "backends" / "lean"

package «fastcrypto-lean» where

/-- `fastcrypto_threshold::threshold_schnorr::avss`, generated by Aeneas. -/
@[default_target]
lean_lib «Avss» { globs := #[.submodules `Avss] }

/-- Proofs about `Avss`. -/
@[default_target]
lean_lib «AvssProofs» { globs := #[.submodules `AvssProofs] }
